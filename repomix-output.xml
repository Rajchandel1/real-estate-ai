ource))].map(s=><div className="funnel" key={s}><div className="between row"><span>{s}</span><b>{ls.filter(l=>l.source===s).length}</b></div><div className="bar"><div style={{width:`${ls.length?100*ls.filter(l=>l.source===s).length/ls.length:0}%`}}/></div></div>)}</section></div><section className="card panel"><h3>Latest enquiries</h3>{leadRows(ls.slice(0,5))}</section></>})()}</>}
