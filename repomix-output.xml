orm.siteColor} onChange={e=>color('siteColor',e.target.value)}/></label>{error&&<p className="error-text" role="alert">{error}</p>}<Button type="submit">Save brand changes</Button></form></section><aside className="card panel preview-card"><h3>Website preview</h3><div className="brand-preview"><span className="preview-brand" style={{background:form.siteColor}}>{form.name.slice(0,2).toUpperCase()}</span><b>{form.name}</b><h2>{form.tagline||'Find your home.'}</h2><p>{form.city||'Your property collection'}</p><span className="theme-pill" style={{background:form.siteColor}}>All homes</span><div className="preview-placeholder">Property preview</div><span className="theme-pill" style={{background:form.siteColor}}>View home →</span></div></aside></div><details className="card panel settings-disclosure"><summary>Team access — optional</summary><p>Work alone? You can leave this closed. Your account is the owner. Add agents here only if they need to use the CRM.</p><TeamSettings/></details><details className="card panel settings-disclosure"><summary>Backups & data management</summary><div className="row gap wrap"><Button variant="secondary" onClick={exportBackup}>Export backup</Button><Button variant="secondary" onClick={openBackup}>Restore backup</Button><Button variant="danger" onClick={()=>{if(window.confirm('Delete all properties, leads and visits? Agency settings will remain.'))void reset().catch(()=>{})}}>Clear agency records</Button></div></details>{notice&&<Toast message={notice} onClose={()=>setNotice('')}/>}</>;
