'use client';
import {useState,type FormEvent} from 'react';
import {ArrowLeft,ArrowRight,Check} from 'lucide-react';
import type {Property} from '@/lib/types';
import {prepareImageUpload,verifyImageUpload} from '@/app/actions/uploads';
import {createSupabaseBrowser} from '@/lib/supabase/browser';
import {PriceField} from './price-field';
import {amountInRupees,inputForPriceUnit,propertyPriceRupees,storedPriceFromRupees,type PriceUnit} from '@/lib/prices';
import {uid} from '@/lib/types';
import {Modal,Button,Field} from '@/components/ui';
import {PropertyOverview} from '@/components/property-overview';
import {propertySchema} from '@/lib/validation';
import {useWorkspace} from '@/store/workspace';
const empty:Property={id:'',title:'',purpose:'sale',type:'apartment',price:0,bhk:2,baths:2,sqft:0,location:'',city:'Ahmedabad',status:'Active',featured:false,description:'',amenities:[],image:'',furnishing:'',societyName:'',createdAt:'',views:0};
const steps=['Basics','Location & area','Home details','Society & floors','Photos & highlights','Review & publish'];
export function PropertyWizard({property,onClose,onSaved}:{property?:Property;onClose:()=>void;onSaved?:()=>void}){const {mutate}=useWorkspace();const [p,setP]=useState<Property>(property?{...property}:{...empty});const [priceAmount,setPriceAmount]=useState(property?inputForPriceUnit(propertyPriceRupees(property),'rupees'):'');const [priceUnit,setPriceUnit]=useState<PriceUnit>('rupees');const [amenitiesText,setAmenitiesText]=useState((property?.amenities||[]).join(', '));const [step,setStep]=useState(0);const [busy,setBusy]=useState(false);const [uploading,setUploading]=useState(false);const [error,setError]=useState('');const isPlot=p.type==='plot';const shown=steps.filter((_,i)=>!isPlot||![2,3].includes(i));const label=shown[step];const change=(key:keyof Property,value:unknown)=>setP(old=>({...old,[key]:value}));
 const rupees=amountInRupees(priceAmount,priceUnit);const price=rupees===null?0:storedPriceFromRupees(rupees,p.purpose);
 const changePriceUnit=(unit:PriceUnit)=>{if(rupees!==null)setPriceAmount(inputForPriceUnit(rupees,unit));setPriceUnit(unit)};
 const validate=()=>{if(label==='Basics'&&(!p.title.trim()||!(price>0)))return 'Enter a property name and a valid price.';if(label==='Location & area'&&(!p.location.trim()||!p.city.trim()||!(p.sqft>0)))return 'Area, city and listed size are required.';if(label==='Society & floors'&&p.floorNumber!==undefined&&p.totalFloors!==undefined&&p.floorNumber>p.totalFloors)return 'Floor number cannot exceed total floors.';return ''};
 const next=()=>{const result=validate();if(result){setError(result);return}setError('');setStep(v=>Math.min(v+1,shown.length-1))};
 const save=(e:FormEvent)=>{e.preventDefault();if(busy||uploading)return;if(label!==shown[shown.length-1]){next();return}try{const record={...p,price,id:property?.id||uid(),amenities:amenitiesText.split(',').map(v=>v.trim()).filter(Boolean),createdAt:property?.createdAt||new Date().toISOString(),views:property?.views||0};const checked=propertySchema.safeParse(record);if(!checked.success){setError(checked.error.issues[0]?.message||'Check the required fields');return}mutate(db=>({...db,properties:property?db.properties.map(x=>x.id===record.id?checked.data:x):[checked.data,...db.properties]}));onSaved?.();onClose()}catch(e){setError(e instanceof Error?e.message:'Could not save property')}};
 const text=(key:keyof Property,placeholder='',type='text')=><input type={type} value={String(p[key]??'')} placeholder={placeholder} onChange={e=>change(key,type==='number'?e.target.value===''?undefined:Number(e.target.value):e.target.value)}/>;
 return <Modal title={property?'Edit property':'Add a new property'} subtitle="Guided listing creation · saved when you publish" wide onClose={onClose}><form onSubmit={save}><div className="wizard-progress"><div className="between row"><b>Step {step+1} of {shown.length}</b><span>{label}</span></div><div className="progress-track"><div style={{width:`${(step+1)/shown.length*100}%`}}/></div></div><div className="modal-body wizard-body"><h3>{label}</h3><div className="form-grid">
 {label==='Basics'&&<><Field label="Property name *" wide>{text('title','e.g. Sunridge Residences')}</Field><Field label="Purpose"><select value={p.purpose} onChange={e=>change('purpose',e.target.value)}><option value="sale">For sale</option><option value="rent">For rent</option></select></Field><Field label="Property type"><select value={p.type} onChange={e=>{change('type',e.target.value);setStep(0)}}>{['apartment','villa','plot','commercial'].map(v=><option key={v} value={v}>{v}</option>)}</select></Field><PriceField amount={priceAmount} unit={priceUnit} purpose={p.purpose} onAmountChange={setPriceAmount} onUnitChange={changePriceUnit}/></>}
 {label==='Location & area'&&<><Field label="Area / neighbourhood *">{text('location','South Bopal')}</Field><Field label="City *">{text('city','Ahmedabad')}</Field><Field label="Built-up / listed area (sqft) *">{text('sqft','1250','number')}</Field><Field label="Carpet area (sqft)">{text('carpetArea','980','number')}</Field></>}
 {label==='Home details'&&<><Field label="Bedrooms">{text('bhk','','number')}</Field><Field label="Bathrooms">{text('baths','','number')}</Field><Field label="Furnishing"><select value={p.furnishing} onChange={e=>change('furnishing',e.target.value)}>{['','Unfurnished','Semi-furnished','Fully furnished'].map(v=><option key={v}>{v}</option>)}</select></Field></>}
 {label==='Society & floors'&&<><Field label="Society / project name" wide>{text('societyName','e.g. Green Heights')}</Field><Field label="Flat on floor">{text('floorNumber','4','number')}</Field><Field label="Total floors">{text('totalFloors','12','number')}</Field></>}
 {label==='Photos & highlights'&&<><Field label="Upload image" wide><input type="file" accept="image/jpeg,image/png,image/webp" disabled={uploading} onChange={async e=>{const file=e.target.files?.[0];if(!file)return;setUploading(true);setError('');try{const signed=await prepareImageUpload({type:file.type as 'image/jpeg'|'image/png'|'image/webp',size:file.size});const {error}=await createSupabaseBrowser().storage.from('property-images').uploadToSignedUrl(signed.path,signed.token,file,{contentType:file.type});if(error)throw error;change('image',await verifyImageUpload({path:signed.path,type:file.type}))}catch(err){setError(err instanceof Error?err.message:'Image upload failed')}finally{setUploading(false)}}}/></Field><Field label="Or image URL" wide>{text('image','https://...')}</Field><Field label="Amenities (comma separated)" wide><input value={amenitiesText} onChange={e=>setAmenitiesText(e.target.value)} placeholder="Parking, Swimming pool, 24 hour security"/></Field><Field label="Description" wide><textarea rows={4} value={p.description} onChange={e=>change('description',e.target.value)}/></Field></>}
 {label==='Review & publish'&&<><div className="wide"><h3>{p.title||'Untitled listing'}</h3><PropertyOverview property={{...p,price,amenities:amenitiesText.split(',').map(v=>v.trim()).filter(Boolean)}} internal/></div><Field label="Status"><select value={p.status} onChange={e=>change('status',e.target.value)}>{['Active','Inactive','Sold','Rented'].map(s=><option key={s}>{s}</option>)}</select></Field><Field label="Featured"><select value={String(p.featured)} onChange={e=>change('featured',e.target.value==='true')}><option value="true">Yes</option><option value="false">No</option></select></Field></>}
 </div>{error&&<p className="error-text" role="alert">{error}</p>}</div><footer className="modal-footer"><Button variant="secondary" onClick={()=>step===0?onClose():setStep(i=>i-1)}>{step===0?'Cancel':<><ArrowLeft size={15}/> Back</>}</Button><span className="hint">Details save on final step</span>{step===shown.length-1?<button className="btn" type="submit" disabled={busy||uploading}><Check size={16}/> {busy?'Adding listing...':'Save property'}</button>:<Button onClick={next} disabled={uploading}>Next <ArrowRight size={16}/></Button>}</footer></form></Modal>}
</file>

