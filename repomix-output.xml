const cols=['title','purpose','type','price','bhk','baths','sqft','location','city','status','featured','description','amenities','image'];
export const csvCell=(v:unknown)=>{let s=String(v??'');if(/^[\s]*[=+@-]/.test(s))s="'"+s;return /[,"\r\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s};
