export function ContactDialog({mode,property,onClose,onDone}:{mode:'enquiry'|'visit';property?:Property;onClose:()=>void;onDone:(s:string)=>void}){const {db}=useWorkspace();const [name,setName]=useState('');const [phone,setPhone]=useState('');const [email,setEmail]=useState('');const [notes,setNotes]=useState('');const [date,setDate]=useState(new Date().toLocaleDateString('en-CA'));const [time,setTime]=useState('11:00');const [error,setError]=useState('');const [submitting,setSubmitting]=useState(false);const [captchaToken,setCaptchaToken]=useState('');const [captchaReset,setCaptchaReset]=useState(0);const [consent,setConsent]=useState(true);const submission=useRef({signature:'',id:''});const submit=async(e:FormEvent)=>{e.preventDefault();if(submitting)return;if(!name.trim()||!validPhone(phone)){setError('Enter a name and valid phone number.');return}if(mode==='visit'&&(!property||date<new Date().toLocaleDateString('en-CA')||db.visits.some(v=>v.propertyId===property.id&&v.date===date&&v.time===time&&['Requested','Confirmed'].includes(v.status)))){setError('Select an available date and time.');return}if(!consent){setError('Please agree to being contacted about your enquiry.');return}const signature=JSON.stringify({name,phone,email,notes,date,time,propertyId:property?.id,mode});if(submission.current.signature!==signature)submission.current={signature,id:crypto.randomUUID()};setSubmitting(true);try{const result=await submitBuyerEnquiry({slug:db.broker.slug,name,phone,email,notes,propertyId:property?.id,mode,date:mode==='visit'?date:undefined,time:mode==='visit'?time:undefined,submissionId:submission.current.id,captchaToken,consent:true});if(!result.ok)throw Error(result.error);onDone(mode==='visit'?'Visit request sent to the agent':'Enquiry sent to the agent')}catch(e){setError(e instanceof Error?e.message:'Failed to send enquiry');setCaptchaToken('');setCaptchaReset(v=>v+1);return}finally{setSubmitting(false)};onClose()};return <Modal title={mode==='visit'?'Request a site visit':'Contact the agent'} subtitle={property?.title||'Share your requirements'} onClose={onClose}><form onSubmit={submit}><div className="modal-body form-grid"><p className="hint wide">Your enquiry will be securely sent to this agency.</p><Field label="Your name *"><input value={name} required onChange={e=>setName(e.target.value)}/></Field><Field label="Phone *"><input value={phone} required onChange={e=>setPhone(e.target.value)}/></Field><Field label="Email" wide><input type="email" value={email} onChange={e=>setEmail(e.target.value)}/></Field><Field label="Requirements / message" wide><textarea value={notes} onChange={e=>setNotes(e.target.value)} rows={3}/></Field>{mode==='visit'&&<><Field label="Date"><input type="date" value={date} onChange={e=>setDate(e.target.value)}/></Field><Field label="Time"><input type="time" value={time} onChange={e=>setTime(e.target.value)}/></Field></>}<label className="wide"><input type="checkbox" checked={consent} onChange={e=>setConsent(e.target.checked)}/> I agree that this agency may contact me about this enquiry. <Link href={"/"+db.broker.slug+"/privacy"} target="_blank">Privacy notice</Link></label><Captcha onToken={setCaptchaToken} resetKey={captchaReset}/>{error&&<p className="error-text wide">{error}</p>}</div><div className="modal-footer"><Button variant="secondary" onClick={onClose}>Cancel</Button><Button type="submit" disabled={submitting}>{submitting?<><span className="spinner"/> Sending…</>:mode==='visit'?'Request visit':'Send enquiry'}</Button></div></form></Modal>}
function Assistant({onClose,onView,onContact}:{onClose:()=>void;onView:(p:Property)=>void;onContact:()=>void}){const {db}=useWorkspace();const [step,setStep]=useState(0);const [req,setReq]=useState<Requirements>({});const questions=['Are you looking to buy or rent?','What kind of property are you looking for?','Your budget range?','Any preferred neighbourhood?','How many bedrooms?'];const active=db.properties.filter(p=>p.status==='Active');const choices:([string,string][])[]=[[['sale','Buy a home'],['rent','Rent a home']],[['any','Any property'],['apartment','Apartment'],['villa','Villa'],['plot','Plot'],['commercial','Commercial']],[['any','Flexible'],['50',req.purpose==='rent'?'Up to ₹50,000 / month':'Up to ₹50,00,000'],['100',req.purpose==='rent'?'Up to ₹1,00,000 / month':'Up to ₹1,00,00,000'],['200',req.purpose==='rent'?'Up to ₹2,00,000 / month':'Up to ₹2,00,00,000']],[['any','Anywhere'],...[...new Set(active.map(p=>p.location))].map(a=>[a,a] as [string,string])],[['any','Any BHK'],['1','1 BHK'],['2','2 BHK'],['3','3 BHK'],['4','4+ BHK']]];const choose=(v:string)=>{const keys:['purpose','type','maxPrice','area','bhk']=['purpose','type','maxPrice','area','bhk'];setReq(r=>({...r,[keys[step]]:v==='any'?undefined:step===2?(req.purpose==='rent'?Number(v)*1000:Number(v)):step===4?Number(v):v}));setStep(s=>s+1)};const matches=matchProperties(active,req).slice(0,5);return <div className="assistant-panel"><div className="assistant-header"><Sparkles size={22}/><div><b>{db.broker.name} · Property finder</b><small>Guided search · Available anytime</small></div><button onClick={onClose} aria-label="Close"><X size={20}/></button></div><div className="assistant-body"><div className="chat-bubble">Hi! I can help find properties that fit your requirements.</div>{step<5?<><div className="chat-bubble">{questions[step]}</div><div className="assistant-choices">{choices[step].map(([v,label])=><button key={v} onClick={()=>choose(v)}>{label} <ArrowRight size={14}/></button>)}</div></>:<