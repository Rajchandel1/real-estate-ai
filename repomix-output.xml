<file path="scripts/dev.mjs">
import fs from 'node:fs';
import path from 'node:path';
import {spawn} from 'node:child_process';
import {randomUUID} from 'node:crypto';

// Two Next processes must never write to the same development output directory.
const lock=path.join(process.cwd(),'.next-dev.lock'),token=randomUUID();
const payload=JSON.stringify({pid:process.pid,token});
function release(){try{if(fs.readFileSync(lock,'utf8')===payload)fs.unlinkSync(lock)}catch{}}
let acquired=false;
for(let attempt=0;attempt<3&&!acquired;attempt++){
 try{fs.writeFileSync(lock,payload,{flag:'wx'});acquired=true}
 catch(error){if(error.code!=='EEXIST')throw error;let old;try{old=JSON.parse(fs.readFileSync(lock,'utf8'))}catch{console.error('Development lock could not be read. Check for an existing server.');process.exit(1)}
  try{process.kill(old.pid,0);console.error('This project already has a development server running. Use its existing URL instead of starting a second server.');process.exit(1)}catch(e){if(e.code!=='ESRCH')throw e}
  fs.unlinkSync(lock);
 }
}
if(!acquired)throw Error('Could not acquire the development server lock');
process.on('exit',release);
const child=spawn(process.execPath,[path.join(process.cwd(),'node_modules','next','dist','bin','next'),'dev',...process.argv.slice(2)],{stdio:'inherit',windowsHide:true});
for(const signal of ['SIGINT','SIGTERM'])process.on(signal,()=>{child.kill(signal)});
child.on('error',()=>{console.error('Could not start Next.js');process.exit(1)});
child.on('exit',code=>process.exit(code??0));
</file>

